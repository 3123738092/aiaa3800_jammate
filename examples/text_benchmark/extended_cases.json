    {
      "id": "tempo_revision",
      "tier": "regression",
      "turns": [
        {"id": "final_number_wins", "text": "先设一百二……不对，我说错了，最终设成 103 BPM。就改速度。", "state": {"tempo": 103}, "preserve_other_layers": []},
        {"id": "subtract_from_current", "text": "刚刚还是赶了点，从现在这个数减 6 BPM，配器别碰。", "state": {"tempo": 97}, "preserve_other_layers": []},
