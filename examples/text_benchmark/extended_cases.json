        {"id": "level_reference_b", "text": "键盘现在又太靠前，降到比刚才轻。鼓保持刚压轻的状态。", "state": {"layers.keys.level": ["<", "before.layers.keys.level"], "tempo": 96}, "preserve_other_layers": ["keys"]},
        {"id": "independent_density_change", "text": "键盘还可以更疏一点，但键盘音量留在现在这档。其他都别动。", "state": {"layers.keys.level": ["=", "before.layers.keys.level"], "layers.keys.density": ["<", "before.layers.keys.density"], "tempo": 96}, "preserve_other_layers": ["keys"]},
        {"id": "restore_only_keys_level_a", "text": "把键盘音量恢复到我第一次把它推前的那一档，刚减少的打点留着，鼓也别跟着恢复。", "state": {"layers.keys.level": ["=", "turn.level_reference_a.layers.keys.level"], "layers.keys.density": ["=", "before.layers.keys.density"], "tempo": 96}, "preserve_other_layers": ["keys"]},
