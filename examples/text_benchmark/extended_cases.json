        {"id": "outside_range_no_substitute", "text": "能做到 203 BPM 就用 203；这个数超出范围的话请告诉我，别自行换成别的数，也别往下一段走。", "outcome": "unsupported", "state": {"tempo": 180, "next_bar": ["=", "before.next_bar"]}, "feedback_contains": ["203", "上限", "范围", "180"]},
        {"id": "valid_after_rejection", "text": "好，那改成 92 BPM 吧，编配仍然不要变。", "state": {"tempo": 92}, "preserve_other_layers": []}
      ]
