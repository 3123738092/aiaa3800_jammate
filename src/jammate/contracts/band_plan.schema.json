{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JamMate BandPlan 1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "session_id", "plan_id", "based_on_state_version", "trigger_event_ids", "strategy", "effective_at", "valid_for_bars", "preserve", "actions", "transport", "plan_confidence", "reason", "unresolved"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "based_on_state_version": {"type": "integer", "minimum": 0},
    "trigger_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "strategy": {"enum": ["LISTEN", "FOLLOW", "RESPOND", "INITIATE"]},
    "effective_at": {"type": "object", "additionalProperties": false, "required": ["bar", "beat"], "properties": {"bar": {"type": "integer", "minimum": 0}, "beat": {"type": "number", "minimum": 0, "exclusiveMaximum": 4}}},
    "valid_for_bars": {"type": "integer", "minimum": 1, "maximum": 16},
    "preserve": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(tempo|key|progression|groove|playing|motif:.+|layer:(drums|bass|keys|lead|guitar|flute|strings|harp|gm_(?:0|[1-9][0-9]?|1[01][0-9]|12[0-7])))$"}},
    "actions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["action", "scope", "strength", "parameters"],
      "properties": {
        "action": {"enum": ["PRESERVE", "ECHO_MOTIF", "VARY_MOTIF", "INTRODUCE_MOTIF", "BUILD", "SIMPLIFY", "ADJUST_FEEL", "INTRODUCE_LAYER", "ADD_LAYER", "REMOVE_LAYER", "SET_KEY", "SET_PROGRESSION", "SET_TEXTURE", "FILL"]},
        "scope": {"anyOf": [{"enum": ["band", "drums", "bass", "keys", "lead", "guitar", "flute", "strings", "harp", "motif"]}, {"type": "string", "pattern": "^gm_(?:0|[1-9][0-9]?|1[01][0-9]|12[0-7])$"}]},
        "strength": {"type": "number", "minimum": 0, "maximum": 1},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "motif_id": {"type": "string", "minLength": 1},
            "rhythm_event_id": {"type": "string", "minLength": 1},
            "duration_bars": {"type": "integer", "minimum": 1, "maximum": 16},
            "level_delta": {"type": "number", "minimum": -1, "maximum": 1},
            "brightness": {"type": "number", "minimum": 0, "maximum": 1},
            "tonic": {"type": "integer", "minimum": 0, "maximum": 11},
            "mode": {"enum": ["major", "minor"]},
            "chords": {"type": "array", "minItems": 2, "maxItems": 8, "items": {
              "type": "object", "additionalProperties": false, "required": ["offset", "quality"],
              "properties": {"offset": {"type": "integer", "minimum": 0, "maximum": 11},
                             "quality": {"enum": ["maj", "min", "dim", "dom7", "maj7", "min7"]}}
            }},
            "scale": {"enum": ["default", "pentatonic", "blues"]},
            "drums": {"enum": ["default", "sparse", "steady", "offbeat"]},
            "bass": {"enum": ["default", "drone", "walking", "syncopated"]},
            "keys": {"enum": ["default", "arpeggio", "staccato", "open"]}
          }
        }
      }
    }},
    "transport": {"type": "object", "additionalProperties": false, "properties": {"playing": {"type": "boolean"}, "tempo_bpm": {"type": "number", "minimum": 60, "maximum": 180}}},
    "plan_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1},
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
